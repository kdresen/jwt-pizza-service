{
  "collectCoverage": true,
  "coverageReporters": ["json-summary", "text"],
  "coverageThreshold": {
    "global": {
      "lines": 80
    }
  },
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "modulePathIgnorePatterns": ["/dist/"],
  "coveragePathIgnorePatterns": ["/node_modules/", "/dist/"]
}
